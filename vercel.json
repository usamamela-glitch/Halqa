{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "redirects": [
    { "source": "/.well-known/carddav", "destination": "/carddav/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/carddav", "destination": "/api/carddav?p=" },
    { "source": "/carddav/:path*", "destination": "/api/carddav?p=:path*" }
  ]
}
